# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either name (publishable key is the same role as the legacy anon key):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (dev: run `npx inngest-cli@latest dev`)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Auto-publish after PDF extraction (false = manual review queue)
AUTO_PUBLISH=true

# Optional: LLM suggestions for titles/summaries + Flutter mobile chat (/api/mobile-chat)
ENABLE_LLM_EXTRACTION=false
OPENAI_API_KEY=

# Flutter mobile chat CORS (default * if unset)
# MOBILE_CORS_ORIGIN=https://your-flutter-app.example

# Firebase Cloud Messaging (admin push). Paste service account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CAPT sync (Firecrawl — bypasses Cloudflare on capt.gov.kw)
CAPT_SYNC_ENABLED=true
CAPT_TENDERS_URL=https://capt.gov.kw/en/
FIRECRAWL_API_KEY=

# MyFatoorah (subscriptions)
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_CURRENCY=KWD
